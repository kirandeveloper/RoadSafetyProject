@page
@model IndexModel

@{
    ViewData["Title"] = "Home page";
}

@Html.AntiForgeryToken()

<!-- Main Content -->
<div class="content-wrapper">
    <!-- Summary Cards -->
    <div class="row mb-4">
        <div class="col-md-4 mb-3">
            <div class="stats-box p-0">
                <img src="img/LC-Banner01.png" alt="LC Banner" class="img-thumbnail rshomeimg" />
            </div>
        </div>
        <div class="col-md-8 mb-3">
            <div class="col-md-12 mb-3">
                <div class="stats-box topcard2">
                    <h3 class="rsheadertop">Road Safety Project</h3>
                </div>
            </div>
            <div class="stats-box bg-light lc-summery">
                <h3>Summery Division Wise LC, Total LC: <span id="totalLC">0</span></h3>
                <div class="row">
                    <div class="col-md-5 col-12 lc-divisions">
                        <h5>Sanctioned</h5>
                        <ul class="lcsactioned">
                            <li><span>Mumbai (BB)</span><span id="sanMumbai">0</span></li>
                            <li><span>Bhusawal (BSL)</span><span id="sanBSL">0</span></li>
                            <li><span>Nagpur (NGP)</span><span id="sanNGP">0</span></li>
                            <li><span>Pune (PA)</span><span id="sanPune">0</span></li>
                            <li><span>Solapur (SUR)</span><span id="sanSUR">0</span></li>
                            <li class="fw-bold border-top pt-1 mt-1"><span>Total Sanctioned</span><span id="totalSanctioned">0</span></li>
                        </ul>
                    </div>
                    <div class="col-md-1">&nbsp;</div>
                    <div class="col-md-5 col-12 lc-divisions">
                        <h5>UnSanctioned</h5>
                        <ul class="lcunsactioned">
                            <li><span>Mumbai (BB)</span><span id="unsMumbai">0</span></li>
                            <li><span>Bhusawal (BSL)</span><span id="unsBSL">0</span></li>
                            <li><span>Nagpur (NGP)</span><span id="unsNGP">0</span></li>
                            <li><span>Pune (PA)</span><span id="unsPune">0</span></li>
                            <li><span>Solapur (SUR)</span><span id="unsSUR">0</span></li>
                            <li class="fw-bold border-top pt-1 mt-1"><span>Total UnSanctioned</span><span id="totalUnSanctioned">0</span></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
        <!-- Summary Cards -->
        <div class="row">
            <!--left side-->
            <!-- Saved LC Records (merged from addnewlc.cshtml) -->
            <div class="col-lg-12 my-4">
                <div class="dashboard-card">
                    <!-- <div class="card-header-custom d-flex justify-content-between align-items-center">
                        <span>Saved LC Records</span>
                        <a class="btn btn-sm btn-light addnewlc" href="addnewlc">+ Add New LC</a>
                    </div>
                    -->
                    <div class="p-3">
                        <div id="recordsStatus" class="mb-2"></div>

                        <ul class="nav nav-tabs" id="recordsTabs" role="tablist">
                            <li class="nav-item" role="presentation">
                                <button class="nav-link active" id="tab-basic-btn" data-bs-toggle="tab" data-bs-target="#tab-basic" type="button" role="tab">Basic Details</button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="tab-tender-btn" data-bs-toggle="tab" data-bs-target="#tab-tender" type="button" role="tab">Tender Details</button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="tab-land-btn" data-bs-toggle="tab" data-bs-target="#tab-land" type="button" role="tab">Land Acquisition</button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="tab-utility-btn" data-bs-toggle="tab" data-bs-target="#tab-utility" type="button" role="tab">Utility Shifting</button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="tab-design-btn" data-bs-toggle="tab" data-bs-target="#tab-design" type="button" role="tab">Design</button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="tab-noc-btn" data-bs-toggle="tab" data-bs-target="#tab-noc" type="button" role="tab">NOC</button>
                            </li>
                        </ul>

                        <div class="tab-content border border-top-0 p-3" id="recordsTabsContent">

                            <!-- Basic Details -->
                            <div class="tab-pane fade show active" id="tab-basic" role="tabpanel">
                                <div id="body-basic">
                                    <p class="text-center text-muted">Loading...</p>
                                </div>
                            </div>

                            <!-- Tender Details -->
                            <div class="tab-pane fade" id="tab-tender" role="tabpanel">
                                <div id="body-tender">
                                    <p class="text-center text-muted">Loading...</p>
                                </div>
                            </div>

                            <!-- Land Acquisition -->
                            <div class="tab-pane fade" id="tab-land" role="tabpanel">
                                <div id="body-land">
                                    <p class="text-center text-muted">Loading...</p>
                                </div>
                            </div>

                            <!-- Utility Shifting -->
                            <div class="tab-pane fade" id="tab-utility" role="tabpanel">
                                <div id="body-utility">
                                    <p class="text-center text-muted">Loading...</p>
                                </div>
                            </div>

                            <!-- Design -->
                            <div class="tab-pane fade" id="tab-design" role="tabpanel">
                                <div id="body-design">
                                    <p class="text-center text-muted">Loading...</p>
                                </div>
                            </div>

                            <!-- NOC -->
                            <div class="tab-pane fade" id="tab-noc" role="tabpanel">
                                <div id="body-noc">
                                    <p class="text-center text-muted">Loading...</p>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
            <!-- Saved LC Records (merged from addnewlc.cshtml) -->


        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js"></script>
    <script>
        (function() {
            // Saved LC Records grid — merged from addnewlc.cshtml.
            // NOTE: the Add/Edit form itself lives on the "addnewlc" page, so the
            // Edit button here just takes the user there instead of populating a
            // local form. Delete works in place against this page's own handlers.

            const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
            const antiForgeryToken = tokenInput ? tokenInput.value : '';
            const recordsStatus = document.getElementById('recordsStatus');

            const tabBodies = {
                basic: document.getElementById('body-basic'),
                tender: document.getElementById('body-tender'),
                land: document.getElementById('body-land'),
                utility: document.getElementById('body-utility'),
                design: document.getElementById('body-design'),
                noc: document.getElementById('body-noc')
            };

            const tabTitles = {
                basic: 'Basic Details',
                tender: 'Tender Details',
                land: 'Land Acquisition',
                utility: 'Utility Shifting',
                design: 'Design',
                noc: 'NOC'
            };

            function setRecordsStatus(message, isError) {
                if (!recordsStatus) return;
                recordsStatus.textContent = message || '';
                recordsStatus.className = 'mb-2 ' + (isError ? 'text-danger' : 'text-success');
            }

            // Division summary counters (top "Summery Division Wise LC" cards).
            // Counts now come straight from the database via
            // IndexModel.OnGetDivisionCounts (?handler=DivisionCounts).
            async function loadDivisionSummary() {
                try {
                    const res = await fetch('?handler=DivisionCounts', { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                    const json = await res.json();
                    if (!json.success) return;

                    let totalSanctioned = 0;
                    let totalUnSanctioned = 0;

                    (json.data || []).forEach(d => {
                        const sanEl = document.getElementById('san' + d.key);
                        const unsEl = document.getElementById('uns' + d.key);
                        if (sanEl) sanEl.textContent = d.sanctioned;
                        if (unsEl) unsEl.textContent = d.unSanctioned;
                        totalSanctioned += d.sanctioned || 0;
                        totalUnSanctioned += d.unSanctioned || 0;
                    });

                    const totalSanEl = document.getElementById('totalSanctioned');
                    const totalUnsEl = document.getElementById('totalUnSanctioned');
                    const totalLcEl = document.getElementById('totalLC');
                    if (totalSanEl) totalSanEl.textContent = totalSanctioned;
                    if (totalUnsEl) totalUnsEl.textContent = totalUnSanctioned;
                    if (totalLcEl) totalLcEl.textContent = totalSanctioned + totalUnSanctioned;
                } catch (err) {
                    console.error('Failed to load division summary:', err);
                }
            }

            function sanitizeFilename(s) {
                return (s || 'export').toString().replace(/[^a-z0-9]+/gi, '_').replace(/^_+|_+$/g, '') || 'export';
            }

            function getTableData(tableEl) {
                const headerCells = Array.from(tableEl.querySelectorAll('thead th'));
                const actionColIndex = headerCells.length - 1;
                const headers = headerCells.slice(0, actionColIndex).map(th => th.textContent.trim());
                const rows = Array.from(tableEl.querySelectorAll('tbody tr')).map(tr =>
                    Array.from(tr.children).slice(0, actionColIndex).map(td => td.textContent.trim())
                );
                return { headers, rows };
            }

            function exportTableToExcel(tableId, filename) {
                const tableEl = document.getElementById(tableId);
                if (!tableEl || typeof XLSX === 'undefined') return;
                const { headers, rows } = getTableData(tableEl);
                const ws = XLSX.utils.aoa_to_sheet([headers, ...rows]);
                const wb = XLSX.utils.book_new();
                XLSX.utils.book_append_sheet(wb, ws, 'Records');
                XLSX.writeFile(wb, `${sanitizeFilename(filename)}.xlsx`);
            }

            function exportTableToPdf(tableId, title, filename) {
                const tableEl = document.getElementById(tableId);
                if (!tableEl || typeof jspdf === 'undefined') return;
                const { headers, rows } = getTableData(tableEl);
                const { jsPDF } = jspdf;
                const doc = new jsPDF({ orientation: 'landscape' });
                doc.setFontSize(12);
                doc.text(title, 14, 12);
                doc.autoTable({
                    head: [headers],
                    body: rows,
                    startY: 18,
                    styles: { fontSize: 7, cellPadding: 2 },
                    headStyles: { fillColor: [30, 60, 114] }
                });
                doc.save(`${sanitizeFilename(filename)}.pdf`);
            }

            function printTable(tableId, title) {
                const tableEl = document.getElementById(tableId);
                if (!tableEl) return;

                const clone = tableEl.cloneNode(true);
                const actionColIndex = clone.querySelectorAll("thead th").length - 1;
                clone.querySelectorAll("tr").forEach(tr => {
                    if (tr.children[actionColIndex]) tr.children[actionColIndex].remove();
                });

                const win = window.open("", "_blank");
                if (!win) return;

                // Built via concatenation on purpose: a literal closing body/html tag in this
                // source gets matched and rewritten by ASP.NET Core's dev-time hot-reload
                // middleware, which would corrupt this script block. Keep it as concatenation.
                const CLOSE_BODY = '</' + 'body>';
                const CLOSE_HTML = '</' + 'html>';

                const popupHtml = '<!DOCTYPE html>' +
                    '<html><head><title>' + esc(title) + '</title>' +
                    '<style>' +
                    'body{font-family:Arial;padding:20px;}' +
                    'table{width:100%;border-collapse:collapse;}' +
                    'th,td{border:1px solid #999;padding:6px;font-size:12px;}' +
                    'th{background:#f5f5f5;}' +
                    '</style>' +
                    '</head><body>' +
                    '<h3>' + esc(title) + '</h3>' +
                    clone.outerHTML +
                    CLOSE_BODY + CLOSE_HTML;

                win.document.open();
                win.document.write(popupHtml);
                win.document.close();

                setTimeout(function() { win.print(); }, 300);
            }

            function esc(v) {
                return (v ?? '').toString().replace(/[&<>"']/g, c => ({
                    '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
                }[c]));
            }

            function actionsCell(id) {
                return `<td>
                                                    <button class="btn btn-sm edit-btn" data-id="${id}"><i class="bi bi-pencil"></i></button>
                                                    <button class="btn btn-sm delete-btn" data-id="${id}"><i class="bi bi-trash"></i></button>
                                       </td>`;
            }

            function yn(v) {
                if (!v) return '';
                const s = v.toString().trim().toUpperCase();
                if (s === 'Y' || s === 'YES') return 'Yes';
                if (s === 'N' || s === 'NO') return 'No';
                return v; // anything else (shouldn't normally happen) — show as-is
            }

            const tabColumns = {
                basic: [
                    { key: 'id', label: 'ID' }, { key: 'yearOfSanction', label: 'Year' },
                    { key: 'lcNo', label: 'LC No.' }, { key: 'locationKm', label: 'Location Km' },
                    { key: 'sectionName', label: 'Section' }, { key: 'spanArrangement', label: 'Span Arrangement' },
                    { key: 'skewAngle', label: 'Skew Angle' }, { key: 'distanceExistingLc', label: 'Distance from Existing LC' },
                    { key: 'stateAuthorityApproval', label: 'State Authority Approval' },
                    { key: 'dprConsultancy', label: 'DPR Consultancy' }, { key: 'executiveAgency', label: 'Executive Agency' }
                ],
                tender: [
                    { key: 'id', label: 'ID' }, { key: 'lcNo', label: 'LC No.' },
                    { key: 'gad', label: 'GAD', fmt: yn }, { key: 'checkedReceived', label: 'Checked & Received', fmt: yn },
                    { key: 'sanctionedCont', label: 'Sanctioned Cont (Cr)' }, { key: 'sanctionedDe', label: 'Sanctioned DE (Cr)' },
                    { key: 'tenderStatus', label: 'Status of Tender' }
                ],
                land: [
                    { key: 'id', label: 'ID' }, { key: 'lcNo', label: 'LC No.' },
                    { key: 'lc7a37a', label: '7A/37A' }, { key: 'gazette20A', label: '20A Gazette' },
                    { key: 'paper20A', label: '20A Paper' }, { key: 'form20B', label: '20B' },
                    { key: 'form20C', label: '20C' }, { key: 'form20D', label: '20D' },
                    { key: 'gazette20E', label: '20E Gazette' }, { key: 'paper20E', label: '20E Paper' },
                    { key: 'form20F', label: '20F' }, { key: 'remark', label: 'Remark' }
                ],
                utility: [
                    { key: 'id', label: 'ID' }, { key: 'lcNo', label: 'LC No.' },
                    { key: 'stStatus', label: 'S & T' }, { key: 'trdStatus', label: 'TRD' }, { key: 'electricalG', label: 'Electrical (G)' }
                ],
                design: [
                    { key: 'id', label: 'ID' }, { key: 'lcNo', label: 'LC No.' },
                    { key: 'substructureStatus', label: 'Substructure' }, { key: 'superStructureStatus', label: 'Super Structure' },
                    { key: 'commissioningStatus', label: 'Commissioning' }, { key: 'gadExit', label: 'Exits/GAD', fmt: yn },
                    { key: 'design', label: 'Design' }, { key: 'exitNo', label: 'Exit No.' }, { key: 'noExit', label: 'No Exit' }
                ],
                noc: [
                    { key: 'id', label: 'ID' }, { key: 'lcNo', label: 'LC No.' },
                    { key: 'nocClosingLc', label: 'NOC of Closing LC' }, { key: 'soa', label: 'SOA' }
                ]
            };

            function groupByDivision(data) {
                const groups = {};
                data.forEach(r => {
                    const key = (r.division && r.division.trim()) ? r.division.trim() : 'Unspecified Division';
                    (groups[key] = groups[key] || []).push(r);
                });
                return Object.keys(groups).sort((a, b) => a.localeCompare(b)).map(name => ({ name, rows: groups[name] }));
            }

            function isUnSanctionRow(r) {
                return (r.lcStatus || '').toString().trim().toLowerCase() === 'unsanction';
            }

            function buildRowsHtml(rows, columns) {
                if (!rows.length) {
                    return `<tr><td colspan="${columns.length + 1}" class="text-center text-muted">No records.</td></tr>`;
                }
                return rows.map(r => {
                    const cells = columns.map(c => `<td>${esc(c.fmt ? c.fmt(r[c.key]) : r[c.key])}</td>`).join('');
                    return `<tr>${cells}${actionsCell(r.id)}</tr>`;
                }).join('');
            }


            // Client-side pagination: 10 records per page for every
            // Sanction / UnSanction table generated on this page.
            function setupTablePagination(tableId, rowsPerPage = 10) {
                const table = document.getElementById(tableId);
                if (!table) return;

                const tbody = table.querySelector('tbody');
                if (!tbody) return;

                const rows = Array.from(tbody.querySelectorAll('tr'));

                // Do not create pagination for an empty result.
                if (rows.length === 0 ||
                    (rows.length === 1 && rows[0].querySelector('td.text-muted'))) {
                    return;
                }

                const pagination = document.getElementById(`${tableId}-pagination`);
                if (!pagination) return;

                const totalRecords = rows.length;
                const totalPages = Math.ceil(totalRecords / rowsPerPage);
                let currentPage = 1;

                function renderPage(page) {
                    currentPage = Math.max(1, Math.min(page, totalPages));

                    const start = (currentPage - 1) * rowsPerPage;
                    const end = start + rowsPerPage;

                    rows.forEach((row, index) => {
                        row.style.display =
                            index >= start && index < end ? '' : 'none';
                    });

                    renderControls();
                }

                function renderControls() {
                    pagination.innerHTML = '';

                    if (totalPages <= 1) {
                        pagination.style.display = 'none';
                        return;
                    }

                    pagination.style.display = 'flex';

                    const startRecord = ((currentPage - 1) * rowsPerPage) + 1;
                    const endRecord = Math.min(currentPage * rowsPerPage, totalRecords);

                    const info = document.createElement('div');
                    info.className = 'table-page-info';
                    info.textContent =
                        `Showing ${startRecord} to ${endRecord} of ${totalRecords} records`;

                    const controls = document.createElement('div');
                    controls.className = 'table-page-controls';

                    const previous = document.createElement('button');
                    previous.type = 'button';
                    previous.className = 'btn btn-sm btn-outline-primary pagination-btn';
                    previous.innerHTML = '&laquo; Previous';
                    previous.disabled = currentPage === 1;
                    previous.addEventListener('click', () => renderPage(currentPage - 1));

                    controls.appendChild(previous);

                    // Show page numbers. For many pages, keep the control compact.
                    let startPage = Math.max(1, currentPage - 2);
                    let endPage = Math.min(totalPages, startPage + 4);

                    if (endPage - startPage < 4) {
                        startPage = Math.max(1, endPage - 4);
                    }

                    if (startPage > 1) {
                        addPageButton(1);

                        if (startPage > 2) {
                            addEllipsis();
                        }
                    }

                    for (let page = startPage; page <= endPage; page++) {
                        addPageButton(page);
                    }

                    if (endPage < totalPages) {
                        if (endPage < totalPages - 1) {
                            addEllipsis();
                        }

                        addPageButton(totalPages);
                    }

                    const next = document.createElement('button');
                    next.type = 'button';
                    next.className = 'btn btn-sm btn-outline-primary pagination-btn';
                    next.innerHTML = 'Next &raquo;';
                    next.disabled = currentPage === totalPages;
                    next.addEventListener('click', () => renderPage(currentPage + 1));

                    controls.appendChild(next);

                    pagination.appendChild(info);
                    pagination.appendChild(controls);

                    function addPageButton(page) {
                        const button = document.createElement('button');
                        button.type = 'button';
                        button.className =
                            `btn btn-sm pagination-btn ${page === currentPage
                                ? 'btn-primary'
                                : 'btn-outline-primary'}`;
                        button.textContent = page;
                        button.addEventListener('click', () => renderPage(page));
                        controls.appendChild(button);
                    }

                    function addEllipsis() {
                        const span = document.createElement('span');
                        span.className = 'pagination-ellipsis';
                        span.textContent = '...';
                        controls.appendChild(span);
                    }
                }

                renderPage(1);
            }

            function buildDivisionTable(divisionName, rows, columns, uid, tabLabel) {
                const headerCells = columns.map(c => `<th>${esc(c.label)}</th>`).join('') + '<th style="width:130px;">Actions</th>';

                const sanctionRows = rows.filter(r => !isUnSanctionRow(r));
                const unsanctionRows = rows.filter(isUnSanctionRow);

                const sanctionTabId = `sanctionTab-${uid}`;
                const unsanctionTabId = `unsanctionTab-${uid}`;
                const navId = `statusTabs-${uid}`;
                const sanctionTableId = `tbl-${sanctionTabId}`;
                const unsanctionTableId = `tbl-${unsanctionTabId}`;

                const sanctionTitle = `${divisionName} - ${tabLabel} (Sanction)`;
                const unsanctionTitle = `${divisionName} - ${tabLabel} (UnSanction)`;
                const sanctionFile = sanitizeFilename(`${divisionName}_${tabLabel}_Sanction`);
                const unsanctionFile = sanitizeFilename(`${divisionName}_${tabLabel}_UnSanction`);

                const toolbar = (tableId, title, filename) => `
                                                                        <div class="d-flex justify-content-end gap-2 mb-2">
                                                                            <button type="button" class="btn btn-sm export-print-btn"
                                                                                            data-table-id="${tableId}" data-title="${esc(title)}"><i class="bi bi-printer-fill"></i></button>
                                                                            <button type="button" class="btn btn-sm export-excel-btn"
                                                                                            data-table-id="${tableId}" data-filename="${esc(filename)}"><i class="bi bi-file-earmark-excel-fill"></i></button>
                                                                            <button type="button" class="btn btn-sm export-pdf-btn"
                                                                                            data-table-id="${tableId}" data-title="${esc(title)}" data-filename="${esc(filename)}"><i class="bi bi-file-earmark-pdf-fill"></i></button>
                                                                        </div>`;

                return `
                                                                                <div class="mb-4">
                                                                                                   <div class="row body-basic-header">
                                                                                      <div class="col-md-6 col-6">
                                                                                           <h5 class="fw-bold mb-2">${esc(divisionName)} <span class="text-muted fw-normal">(${rows.length} record${rows.length === 1 ? '' : 's'})</span></h5>
                                                                                      </div>
                                                                                      <div class="col-md-6 col-6">
                                                                                                 <ul class="nav nav-tabs mb-3 justify-content-end" id="${navId}" role="tablist">
                                                                                               <li class="nav-item">
                                                                                                    <button class="nav-link sanction-tab active"
                                                                                                            data-bs-toggle="tab"
                                                                                                            data-bs-target="#${sanctionTabId}"
                                                                                                            type="button">
                                                                                                        Sanction (${sanctionRows.length})
                                                                                                    </button>
                                                                                                </li>

                                                                                                <li class="nav-item">
                                                                                                    <button class="nav-link unsanction-tab"
                                                                                                            data-bs-toggle="tab"
                                                                                                            data-bs-target="#${unsanctionTabId}"
                                                                                                            type="button">
                                                                                                        UnSanction (${unsanctionRows.length})
                                                                                                    </button>
                                                                                                </li>
                                                                                        </ul>
                                                                                      </div>
                                                                                   </div>

                                                                                    <div class="table-responsive">

                                           
                                                            <div class="tab-content">
                                                            <div class="tab-pane fade show active" id="${sanctionTabId}">
                                                                    <h3 class="pt-4 ps-3 text-success">Status of Sanction work for LC elimination under construction/Road Saftey Project</h3>
                                                            ${toolbar(sanctionTableId, sanctionTitle, sanctionFile)}
                                                            <table id="${sanctionTableId}" class="table table-bordered table-hover align-middle table-sm">
                                                                                            <thead><tr>${headerCells}</tr></thead>
                                                                                            <tbody>${buildRowsHtml(sanctionRows, columns)}</tbody>
                                                                                        </table>
                                                                                        <div id="${sanctionTableId}-pagination" class="table-pagination"></div>
                                                            </div>
                                                            <div class="tab-pane fade" id="${unsanctionTabId}">
                                                                    <h3 class="pt-4 ps-3 text-danger">Status of UnSanction work ROB assigned to RSP</h3>
                                                            ${toolbar(unsanctionTableId, unsanctionTitle, unsanctionFile)}
                                                            <table id="${unsanctionTableId}" class="table table-bordered table-hover align-middle table-sm">
                                                                                            <thead><tr>${headerCells}</tr></thead>
                                                                                            <tbody>${buildRowsHtml(unsanctionRows, columns)}</tbody>
                                                                                        </table>
                                                                                        <div id="${unsanctionTableId}-pagination" class="table-pagination"></div>
                                                            </div>
                                                            </div>

                                                                                    </div>
                                                                                </div>`;
            }

            function renderTabs(data) {
                if (!data || data.length === 0) {
                    Object.values(tabBodies).forEach(el => {
                        el.innerHTML = '<p class="text-center text-muted">No records found.</p>';
                    });
                    return;
                }

                const groups = groupByDivision(data);

                Object.keys(tabColumns).forEach(tabKey => {
                    const columns = tabColumns[tabKey];
                    tabBodies[tabKey].innerHTML = groups
                        .map((g, idx) => buildDivisionTable(g.name, g.rows, columns, `${tabKey}-${idx}`, tabTitles[tabKey] || tabKey))
                        .join('');

                    // Give every generated Sanction / UnSanction table its own
                    // client-side pagination with 10 records per page.
                    tabBodies[tabKey]
                        .querySelectorAll('table[id^="tbl-"]')
                        .forEach(table => setupTablePagination(table.id, 10));
                });
            }

            async function loadRecords() {
                Object.values(tabBodies).forEach(tb => {
                    tb.innerHTML = '<p class="text-center text-muted">Loading...</p>';
                });
                try {
                    const res = await fetch('?handler=List', { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                    const json = await res.json();
                    if (!json.success) {
                        setRecordsStatus(json.message || 'Failed to load records.', true);
                        return;
                    }
                    renderTabs(json.data);
                } catch (err) {
                    setRecordsStatus('Failed to load records: ' + err.message, true);
                }
            }

            const recordsTabs = document.getElementById("recordsTabsContent");

            if (recordsTabs) {
                recordsTabs.addEventListener("click", async function(e) {

                    // Export buttons
                    const exportBtn = e.target.closest(".export-print-btn, .export-excel-btn, .export-pdf-btn");
                    if (exportBtn) {
                        const tableId = exportBtn.getAttribute("data-table-id");
                        const title = exportBtn.getAttribute("data-title") || "Records";
                        const filename = exportBtn.getAttribute("data-filename") || "records";

                        if (exportBtn.classList.contains("export-print-btn")) {
                            printTable(tableId, title);
                        } else if (exportBtn.classList.contains("export-excel-btn")) {
                            exportTableToExcel(tableId, filename);
                        } else if (exportBtn.classList.contains("export-pdf-btn")) {
                            exportTableToPdf(tableId, title, filename);
                        }
                        return;
                    }

                    // Edit / Delete buttons
                    const btn = e.target.closest(".edit-btn, .delete-btn");
                    if (!btn) return;

                    const id = btn.getAttribute("data-id");
                    if (!id) return;

                    // Edit: the add/edit form lives on the "addnewlc" page, so send the
                    // user there. (Wire up a matching ?id= pre-fill on that page if you
                    // want the record to load automatically.)
                    if (btn.classList.contains("edit-btn")) {
                        window.location.href = `addnewlc?id=${id}`;
                        return;
                    }

                    // Delete
                    if (btn.classList.contains("delete-btn")) {
                        if (!confirm("Delete this record permanently?")) return;

                        try {
                            const response = await fetch(`?handler=Delete&id=${id}`, {
                                method: "POST",
                                headers: { "RequestVerificationToken": antiForgeryToken }
                            });

                            if (!response.ok) throw new Error("Delete failed.");

                            const json = await response.json();
                            setRecordsStatus(json.message, !json.success);

                            if (json.success) {
                                await loadRecords();
                                await loadDivisionSummary();
                            }
                        } catch (err) {
                            setRecordsStatus(err.message, true);
                        }
                    }
                });
            }

            loadRecords();
            loadDivisionSummary();
        })();
    </script>
}