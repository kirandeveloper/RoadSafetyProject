@page
@model RoadSafetyProject.Pages.addnewlcModel
@{
    ViewData["Title"] = "Road Safety Project";
}
@Html.AntiForgeryToken()
<div class="content-wrapper">
    <!-- Summary Cards -->
    <div class="container-fluid mb-4">
        <div class="col-md-12">
            <div class="form-card">
                <div class="rob-sheet">
                    <!-- Title block -->
                    <div class="rob-titleblock">
                        <div>
                            <div class="eyebrow">Road Over Bridge · Project Data Sheet</div>
                            <h1>Add New LC Form</h1>
                        </div>
                        <div class="rob-meta">
                            Form ref: ROB/DS/2026<br>
                            All fields marked * are mandatory
                        </div>
                        <div class="rob-progress" style="width:100%;">
                            <div class="rob-progress-fill" id="progressFill"></div>
                        </div>
                    </div>

                    <form id="robForm" class="needs-validation" novalidate>
                        <div class="row mb-3">
                            <div class="col-md-12">
                                <label class="form-label fw-bold">LC Status</label><br />
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" name="LcStatus" id="statusSanction" value="Sanction" checked>
                                    <label class="form-check-label" for="statusSanction">Sanction</label>
                                </div>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" name="LcStatus" id="statusUnSanction" value="UnSanction">
                                    <label class="form-check-label" for="statusUnSanction">UnSanction</label>
                                </div>
                            </div>
                        </div>

                        <input type="hidden" id="recordId" name="id" value="0" />

                        <!-- 01 Basic Details -->
                        <div class="rob-panel">
                            <div class="section-title">
                                <span class="num">01</span>
                                <span class="txt">Basic Details</span>
                                <span class="sub">Sanction &amp; Location</span>
                            </div>
                            <div class="row">
                                <div class="col-md-3 mb-3">
                                    <div class="form-floating">
                                        <input type="text" class="form-control" id="division" name="division" placeholder=" " required />
                                        <label for="division" class="req-label">Enter Division</label>
                                    </div>
                                    <div class="invalid-feedback">Division is required.</div>
                                </div>
                                <div class="col-md-3 mb-3">
                                    <div class="form-floating">
                                        <input type="text" class="form-control" id="yearSanction" name="yearSanction" placeholder=" " required />
                                        <label for="yearSanction" class="req-label">Year of Sanction</label>
                                    </div>
                                    <div class="invalid-feedback">Enter a valid 4-digit year (1950–2100).</div>
                                </div>
                                <div class="col-md-3 mb-3">
                                    <div class="form-floating">
                                        <input type="text" class="form-control" id="lcNo" name="lcNo"
                                               placeholder=" " required />
                                        <label for="lcNo" class="req-label">LC No.</label>
                                    </div>
                                    <div class="invalid-feedback">Use letters, numbers, "-" or "/" only.</div>
                                </div>
                                <div class="col-md-3 mb-3">
                                    <div class="form-floating">
                                        <input type="text" class="form-control" id="locationKm" name="locationKm"
                                               placeholder=" " required />
                                        <label for="locationKm" class="req-label">Location Km</label>
                                    </div>
                                    <div class="invalid-feedback">Enter chainage as a number, e.g. 42.350.</div>
                                </div>
                                <div class="col-md-3 mb-3">
                                    <div class="form-floating">
                                        <input type="text" class="form-control" id="section" name="section"
                                               placeholder=" " required minlength="2">
                                        <label for="section" class="req-label">Section</label>
                                    </div>
                                    <div class="invalid-feedback">Section name is required.</div>
                                </div>

                                <div class="col-md-4 mb-3">
                                    <div class="form-floating">
                                        <input type="text" class="form-control" id="spanArrangement" name="spanArrangement"
                                               placeholder=" " required>
                                        <label for="spanArrangement" class="req-label">Span Arrangement</label>
                                    </div>
                                    <div class="invalid-feedback">Span arrangement is required, e.g. 3x18.3m.</div>
                                </div>

                                <div class="col-md-4 mb-3">
                                    <div class="form-floating">
                                        <input type="text" class="form-control" id="skewAngle" name="skewAngle"
                                               placeholder=" " required />
                                        <label for="skewAngle" class="req-label">Skew Angle (°)</label>
                                    </div>
                                    <div class="invalid-feedback">Skew angle must be between 0° and 90°.</div>
                                </div>

                                <div class="col-md-4 mb-3">
                                    <div class="form-floating">
                                        <input type="text" class="form-control" id="distanceLc" name="distanceLc"
                                               placeholder=" " required />
                                        <label for="distanceLc" class="req-label">Distance from Existing LC (m)</label>
                                    </div>
                                    <div class="invalid-feedback">Enter distance in metres (0 or more).</div>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <div class="form-floating">
                                        <input type="text" class="form-control" id="stateApproval" name="stateApproval"
                                               placeholder=" " required minlength="2">
                                        <label for="stateApproval" class="req-label">State Authority Approval on Plan / GAD</label>
                                    </div>
                                    <div class="invalid-feedback">This field is required.</div>
                                </div>

                                <div class="col-md-3 mb-3">
                                    <div class="form-floating">
                                        <input type="text" class="form-control" id="dprConsultancy" name="dprConsultancy"
                                               placeholder=" " required minlength="2">
                                        <label for="dprConsultancy" class="req-label">Name of DPR Consultancy</label>
                                    </div>
                                    <div class="invalid-feedback">This field is required.</div>
                                </div>

                                <div class="col-md-3 mb-3">
                                    <div class="form-floating">
                                        <input type="text" class="form-control" id="executiveAgency" name="executiveAgency"
                                               placeholder=" " required minlength="2">
                                        <label for="executiveAgency" class="req-label">Name of Executive Agency</label>
                                    </div>
                                    <div class="invalid-feedback">This field is required.</div>
                                </div>
                            </div>
                        </div>
                        <!-- 01 Basic Details -->
                        <!-- 02 Tender Details -->
                        <div class="rob-panel">
                            <div class="section-title">
                                <span class="num">02</span>
                                <span class="txt">Tender Details</span>
                                <span class="sub">Cost &amp; Status</span>
                            </div>
                            <div class="row">

                                <div class="col-md-2 mb-3">
                                    <div class="form-floating">
                                        <select class="form-select yn-select" id="gad" name="gad" data-remark-for="gad" required>
                                            <option value="" disabled selected hidden>Select</option>
                                            <option value="Yes">Yes</option>
                                            <option value="No">No</option>
                                        </select>
                                        <label for="gad" class="req-label">
                                            GAD
                                        </label>
                                    </div>
                                    <div class="invalid-feedback">Please select an option.</div>
                                    <div class="mt-2 d-none" id="gadRemarkWrap">
                                        <div class="form-floating">
                                            <textarea class="form-control" id="gadRemark" name="gadRemark" placeholder=" "></textarea>
                                            <label for="gadRemark" class="req-label">GAD Remark</label>
                                        </div>
                                        <div class="invalid-feedback">Please give a reason since GAD is No.</div>
                                    </div>
                                </div>

                                <div class="col-md-3 mb-3">
                                    <div class="form-floating">
                                        <select class="form-select yn-select" id="checkedReceived" name="checkedReceived" data-remark-for="checkedReceived" required>
                                            <option value="" disabled selected hidden>Select</option>
                                            <option value="Yes">Yes</option>
                                            <option value="No">No</option>
                                        </select>
                                        <label for="checkedReceived" class="req-label">Checked &amp; Received</label>
                                    </div>
                                    <div class="invalid-feedback">Please select an option.</div>
                                    <div class="mt-2 d-none" id="checkedReceivedRemarkWrap">
                                        <div class="form-floating">
                                            <textarea class="form-control" id="checkedReceivedRemark" name="checkedReceivedRemark" placeholder=" "></textarea>
                                            <label for="checkedReceivedRemark" class="req-label">Checked &amp; Received Remark</label>
                                        </div>
                                        <div class="invalid-feedback">Please give a reason since Checked &amp; Received is No.</div>
                                    </div>
                                </div>

                                <div class="col-md-2 mb-3">
                                    <div class="form-floating">
                                        <input type="text" class="form-control" id="sanctionedCont" name="sanctionedCont"
                                               placeholder=" " required />
                                        <label for="sanctionedCont" class="req-label">Sanctioned Cont (Cr)</label>
                                    </div>
                                    <div class="invalid-feedback">Enter a non-negative amount.</div>
                                </div>

                                <div class="col-md-2 mb-3">
                                    <div class="form-floating">
                                        <input type="text" class="form-control" id="sanctionedDe" name="sanctionedDe"
                                               placeholder=" " required />
                                        <label for="sanctionedDe" class="req-label">Sanctioned DE (Cr)</label>
                                    </div>
                                    <div class="invalid-feedback">Enter a non-negative amount.</div>
                                </div>

                                <div class="col-md-3 mb-3">
                                    <div class="form-floating">
                                        <input type="text" class="form-control" id="tenderStatus" name="tenderStatus"
                                               placeholder=" " required minlength="2">
                                        <label for="tenderStatus" class="req-label">Status of Tender</label>
                                    </div>
                                    <div class="invalid-feedback">This field is required.</div>
                                </div>

                            </div>
                        </div>
                        <!-- 02 Tender Details -->
                        <!-- 03 Land Acquisition -->
                        <div class="rob-panel">
                            <div class="section-title">
                                <span class="num">03</span>
                                <span class="txt">Land Acquisition</span>
                                <span class="sub">Notifications &amp; Awards</span>
                            </div>
                            <div class="row">

                                <div class="col-md-4 mb-3">
                                    <div class="form-floating">
                                        <textarea class="form-control" id="sec7a" name="sec7a" placeholder=" " required minlength="2"></textarea>
                                        <label for="sec7a" class="req-label">7A / 37A</label>
                                    </div>
                                    <div class="invalid-feedback">This field is required.</div>
                                </div>

                                <div class="col-md-4 mb-3">
                                    <div class="form-floating">
                                        <textarea class="form-control" id="sec20aGazette" name="sec20aGazette" placeholder=" " required minlength="2"></textarea>
                                        <label for="sec20aGazette" class="req-label">20A Gazette Notification</label>
                                    </div>
                                    <div class="invalid-feedback">This field is required.</div>
                                </div>

                                <div class="col-md-4 mb-3">
                                    <div class="form-floating">
                                        <textarea class="form-control" id="sec20aPaper" name="sec20aPaper" placeholder=" " required minlength="2"></textarea>
                                        <label for="sec20aPaper" class="req-label">20A Paper Publication</label>
                                    </div>
                                    <div class="invalid-feedback">This field is required.</div>
                                </div>

                                <div class="col-md-3 mb-3">
                                    <div class="form-floating">
                                        <textarea class="form-control" id="sec20b" name="sec20b" placeholder=" " required minlength="2"></textarea>
                                        <label for="sec20b" class="req-label">20B</label>
                                    </div>
                                    <div class="invalid-feedback">This field is required.</div>
                                </div>

                                <div class="col-md-3 mb-3">
                                    <div class="form-floating">
                                        <textarea class="form-control" id="sec20c" name="sec20c" placeholder=" " required minlength="2"></textarea>
                                        <label for="sec20c" class="req-label">20C</label>
                                    </div>
                                    <div class="invalid-feedback">This field is required.</div>
                                </div>

                                <div class="col-md-3 mb-3">
                                    <div class="form-floating">
                                        <textarea class="form-control" id="sec20d" name="sec20d" placeholder=" " required minlength="2"></textarea>
                                        <label for="sec20d" class="req-label">20D</label>
                                    </div>
                                    <div class="invalid-feedback">This field is required.</div>
                                </div>

                                <div class="col-md-3 mb-3">
                                    <div class="form-floating">
                                        <textarea class="form-control" id="sec20eGazette" name="sec20eGazette" placeholder=" " required minlength="2"></textarea>
                                        <label for="sec20eGazette" class="req-label">20E Gazette Notification</label>
                                    </div>
                                    <div class="invalid-feedback">This field is required.</div>
                                </div>

                                <div class="col-md-4 mb-3">
                                    <div class="form-floating">
                                        <textarea class="form-control" id="sec20ePaper" name="sec20ePaper" placeholder=" " required minlength="2"></textarea>
                                        <label for="sec20ePaper" class="req-label">20E Paper Publication</label>
                                    </div>
                                    <div class="invalid-feedback">This field is required.</div>
                                </div>

                                <div class="col-md-4 mb-3">
                                    <div class="form-floating">
                                        <textarea class="form-control" id="sec20f" name="sec20f" placeholder=" " required minlength="2"></textarea>
                                        <label for="sec20f" class="req-label">20F</label>
                                    </div>
                                    <div class="invalid-feedback">This field is required.</div>
                                </div>

                                <div class="col-md-4 mb-3">
                                    <div class="form-floating">
                                        <textarea class="form-control" id="landRemark" name="landRemark" placeholder=" " required minlength="2"></textarea>
                                        <label for="landRemark" class="req-label">Remark</label>
                                    </div>
                                    <div class="invalid-feedback">This field is required.</div>
                                </div>

                            </div>
                        </div>
                        <!-- 03 Land Acquisition -->
                        <!-- 04 Utility Shifting -->
                        <div class="rob-panel">
                            <div class="section-title">
                                <span class="num">04</span>
                                <span class="txt">Utility Shifting</span>
                                <span class="sub">S&amp;T · TRD · Electrical</span>
                            </div>
                            <div class="row">

                                <div class="col-md-4 mb-3">
                                    <div class="form-floating">
                                        <textarea class="form-control" id="utilSnt" name="utilSnt" placeholder=" " required minlength="2"></textarea>
                                        <label for="utilSnt" class="req-label">S &amp; T</label>
                                    </div>
                                    <div class="invalid-feedback">This field is required.</div>
                                </div>

                                <div class="col-md-4 mb-3">
                                    <div class="form-floating">
                                        <textarea class="form-control" id="utilTrd" name="utilTrd" placeholder=" " required minlength="2"></textarea>
                                        <label for="utilTrd" class="req-label">TRD</label>
                                    </div>
                                    <div class="invalid-feedback">This field is required.</div>
                                </div>

                                <div class="col-md-4 mb-3">
                                    <div class="form-floating">
                                        <textarea class="form-control" id="utilElectrical" name="utilElectrical" placeholder=" " required minlength="2"></textarea>
                                        <label for="utilElectrical" class="req-label">Electrical (G)</label>
                                    </div>
                                    <div class="invalid-feedback">This field is required.</div>
                                </div>

                            </div>
                        </div>
                        <!-- 04 Utility Shifting -->
                        <!-- 05 Design -->
                        <div class="rob-panel">
                            <div class="section-title">
                                <span class="num">05</span>
                                <span class="txt">Design</span>
                                <span class="sub">Structure &amp; Exits</span>
                            </div>
                            <div class="row">

                                <div class="col-md-4 mb-3">
                                    <div class="form-floating">
                                        <textarea class="form-control" id="substructure" name="substructure" placeholder=" " required minlength="2"></textarea>
                                        <label for="substructure" class="req-label">Substructure</label>
                                    </div>
                                    <div class="invalid-feedback">This field is required.</div>
                                </div>

                                <div class="col-md-4 mb-3">
                                    <div class="form-floating">
                                        <textarea class="form-control" id="superstructure" name="superstructure" placeholder=" " required minlength="2"></textarea>
                                        <label for="superstructure" class="req-label">Super Structure</label>
                                    </div>
                                    <div class="invalid-feedback">This field is required.</div>
                                </div>

                                <div class="col-md-4 mb-3">
                                    <div class="form-floating">
                                        <textarea class="form-control" id="commissioning" name="commissioning" placeholder=" " required minlength="2"></textarea>
                                        <label for="commissioning" class="req-label">Commissioning</label>
                                    </div>
                                    <div class="invalid-feedback">This field is required.</div>
                                </div>

                                <div class="col-md-3 mb-3">
                                    <div class="form-floating">
                                        <select class="form-select yn-select" id="exitsGad" name="exitsGad" data-remark-for="exitsGad" required>
                                            <option value="" disabled selected hidden>Select</option>
                                            <option value="Yes">Yes</option>
                                            <option value="No">No</option>
                                        </select>
                                        <label for="exitsGad" class="req-label">EXITS / GAD</label>
                                    </div>
                                    <div class="invalid-feedback">Please select an option.</div>
                                    <div class="mt-2 d-none" id="exitsGadRemarkWrap">
                                        <div class="form-floating">
                                            <textarea class="form-control" id="exitsGadRemark" name="exitsGadRemark" placeholder=" "></textarea>
                                            <label for="exitsGadRemark" class="req-label">EXITS / GAD Remark</label>
                                        </div>
                                        <div class="invalid-feedback">Please give a reason since EXITS / GAD is No.</div>
                                    </div>
                                </div>

                                <div class="col-md-3 mb-3">
                                    <div class="form-floating">
                                        <input type="text" class="form-control" id="designField" name="designField" placeholder=" " required minlength="2">
                                        <label for="designField" class="req-label">Design</label>
                                    </div>
                                    <div class="invalid-feedback">This field is required.</div>
                                </div>

                                <div class="col-md-3 mb-3">
                                    <div class="form-floating">
                                        <input type="text" class="form-control" id="exitNo" name="exitNo" placeholder=" " required minlength="1">
                                        <label for="exitNo" class="req-label">Exit No.</label>
                                    </div>
                                    <div class="invalid-feedback">This field is required.</div>
                                </div>

                                <div class="col-md-3 mb-3">
                                    <div class="form-floating">
                                        <input type="text" class="form-control" id="noExit" name="noExit" placeholder=" " required minlength="1">
                                        <label for="noExit" class="req-label">No Exit</label>
                                    </div>
                                    <div class="invalid-feedback">This field is required.</div>
                                </div>

                            </div>
                        </div>
                        <!-- 05 Design -->
                        <!-- 06 NOC -->
                        <div class="rob-panel">
                            <div class="section-title">
                                <span class="num">06</span>
                                <span class="txt">NOC</span>
                                <span class="sub">Closing &amp; SOA</span>
                            </div>
                            <div class="row">

                                <div class="col-md-6 mb-3">
                                    <div class="form-floating">
                                        <textarea class="form-control" id="nocClosingLc" name="nocClosingLc" placeholder=" " required minlength="2" style="min-height:110px;"></textarea>
                                        <label for="nocClosingLc" class="req-label">NOC of Closing LC</label>
                                    </div>
                                    <div class="invalid-feedback">This field is required.</div>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <div class="form-floating">
                                        <textarea class="form-control" id="soa" name="soa" placeholder=" " required minlength="2" style="min-height:110px;"></textarea>
                                        <label for="soa" class="req-label">SOA</label>
                                    </div>
                                    <div class="invalid-feedback">This field is required.</div>
                                </div>

                            </div>
                        </div>
                        <!-- 06 NOC -->
                        <div class="rob-actions">
                            <button type="submit" class="btn-rob-primary" id="saveBtn">Save Details</button>
                            <button type="button" id="resetBtn" class="btn-rob-secondary">Reset</button>
                        </div>
                        <div class="rob-status" id="formStatus"></div>
                    </form>

                    <!-- View / Manage records -->
                    <div class="rob-panel">
                        <div class="section-title">
                            <span class="num">07</span>
                            <span class="txt">Saved LC Records</span>
                            <span class="sub">View · Edit · Delete</span>
                        </div>

                        <ul class="nav nav-tabs" id="recordsTabs" role="tablist">
                            <li class="nav-item" role="presentation">
                                <button class="nav-link active" id="tab-basic-btn" data-bs-toggle="tab" data-bs-target="#tab-basic" type="button" role="tab">Basic Details</button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="tab-tender-btn" data-bs-toggle="tab" data-bs-target="#tab-tender" type="button" role="tab">Tender Details</button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="tab-land-btn" data-bs-toggle="tab" data-bs-target="#tab-land" type="button" role="tab">Land Acquisition</button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="tab-utility-btn" data-bs-toggle="tab" data-bs-target="#tab-utility" type="button" role="tab">Utility Shifting</button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="tab-design-btn" data-bs-toggle="tab" data-bs-target="#tab-design" type="button" role="tab">Design</button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="tab-noc-btn" data-bs-toggle="tab" data-bs-target="#tab-noc" type="button" role="tab">NOC</button>
                            </li>
                        </ul>

                        <div class="tab-content border border-top-0 p-3" id="recordsTabsContent">

                            <!-- Basic Details -->
                            <div class="tab-pane fade show active" id="tab-basic" role="tabpanel">
                                <div id="body-basic"><p class="text-center text-muted">Loading...</p></div>
                            </div>

                            <!-- Tender Details -->
                            <div class="tab-pane fade" id="tab-tender" role="tabpanel">
                                <div id="body-tender"><p class="text-center text-muted">Loading...</p></div>
                            </div>

                            <!-- Land Acquisition -->
                            <div class="tab-pane fade" id="tab-land" role="tabpanel">
                                <div id="body-land"><p class="text-center text-muted">Loading...</p></div>
                            </div>

                            <!-- Utility Shifting -->
                            <div class="tab-pane fade" id="tab-utility" role="tabpanel">
                                <div id="body-utility"><p class="text-center text-muted">Loading...</p></div>
                            </div>

                            <!-- Design -->
                            <div class="tab-pane fade" id="tab-design" role="tabpanel">
                                <div id="body-design"><p class="text-center text-muted">Loading...</p></div>
                            </div>

                            <!-- NOC -->
                            <div class="tab-pane fade" id="tab-noc" role="tabpanel">
                                <div id="body-noc"><p class="text-center text-muted">Loading...</p></div>
                            </div>

                        </div>
                    </div>
                    <!-- View / Manage records -->
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js"></script>
    <script>
        (function () {
            const form = document.getElementById('robForm');
            const status = document.getElementById('formStatus');
            const resetBtn = document.getElementById('resetBtn');
            const antiForgeryToken = document.querySelector('input[name="__RequestVerificationToken"]').value;

            // Yes/No selects that reveal a "why" remark textarea when the answer is "No".
            // The textarea is shown/hidden, marked required only while visible, and
            // cleared when hidden so a stale remark can't get saved for a "Yes" answer.
            function syncYesNoRemark(fieldId) {
                const select = document.getElementById(fieldId);
                const wrap = document.getElementById(fieldId + 'RemarkWrap');
                const textarea = document.getElementById(fieldId + 'Remark');
                if (!select || !wrap || !textarea) return;

                const isNo = select.value === 'No';
                wrap.classList.toggle('d-none', !isNo);
                textarea.required = isNo;
                if (!isNo) textarea.value = '';
            }

            document.querySelectorAll('.yn-select').forEach(select => {
                const fieldId = select.getAttribute('data-remark-for') || select.id;
                select.addEventListener('change', () => syncYesNoRemark(fieldId));
                syncYesNoRemark(fieldId); // initial state on page load
            });

            const tabBodies = {
                basic: document.getElementById('body-basic'),
                tender: document.getElementById('body-tender'),
                land: document.getElementById('body-land'),
                utility: document.getElementById('body-utility'),
                design: document.getElementById('body-design'),
                noc: document.getElementById('body-noc')
            };

            // Friendly labels for the six category tabs, used in export titles/filenames.
            const tabTitles = {
                basic: 'Basic Details',
                tender: 'Tender Details',
                land: 'Land Acquisition',
                utility: 'Utility Shifting',
                design: 'Design',
                noc: 'NOC'
            };

            function sanitizeFilename(s) {
                return (s || 'export').toString().replace(/[^a-z0-9]+/gi, '_').replace(/^_+|_+$/g, '') || 'export';
            }

            // Reads header/body text out of a rendered table, dropping the trailing Actions column.
            function getTableData(tableEl) {
                const headerCells = Array.from(tableEl.querySelectorAll('thead th'));
                const actionColIndex = headerCells.length - 1;
                const headers = headerCells.slice(0, actionColIndex).map(th => th.textContent.trim());
                const rows = Array.from(tableEl.querySelectorAll('tbody tr')).map(tr =>
                    Array.from(tr.children).slice(0, actionColIndex).map(td => td.textContent.trim())
                );
                return { headers, rows };
            }

            function exportTableToExcel(tableId, filename) {
                const tableEl = document.getElementById(tableId);
                if (!tableEl || typeof XLSX === 'undefined') return;
                const { headers, rows } = getTableData(tableEl);
                const ws = XLSX.utils.aoa_to_sheet([headers, ...rows]);
                const wb = XLSX.utils.book_new();
                XLSX.utils.book_append_sheet(wb, ws, 'Records');
                XLSX.writeFile(wb, `${sanitizeFilename(filename)}.xlsx`);
            }

            function exportTableToPdf(tableId, title, filename) {
                const tableEl = document.getElementById(tableId);
                if (!tableEl || typeof jspdf === 'undefined') return;
                const { headers, rows } = getTableData(tableEl);
                const { jsPDF } = jspdf;
                const doc = new jsPDF({ orientation: 'landscape' });
                doc.setFontSize(12);
                doc.text(title, 14, 12);
                doc.autoTable({
                    head: [headers],
                    body: rows,
                    startY: 18,
                    styles: { fontSize: 7, cellPadding: 2 },
                    headStyles: { fillColor: [30, 60, 114] }
                });
                doc.save(`${sanitizeFilename(filename)}.pdf`);
            }

            function printTable(tableId, title) {

                const tableEl = document.getElementById(tableId);

                if (!tableEl) return;

                const clone = tableEl.cloneNode(true);

                const actionColIndex = clone.querySelectorAll("thead th").length - 1;

                clone.querySelectorAll("tr").forEach(tr => {

                    if (tr.children[actionColIndex])

                        tr.children[actionColIndex].remove();

                });

                const win = window.open("", "_blank");

                if (!win) return;

                // IMPORTANT: build the closing body/html tag text via concatenation, never as a
                // literal string. ASP.NET Core's dev-time hot-reload middleware scans the rendered
                // response for that literal closing-body tag text and injects a real script
                // reference right there. If that exact text appears anywhere in our own source
                // (including inside a template literal like this one), it gets matched and a real
                // script tag gets injected mid-string — which ends this page's own script block
                // early and dumps the rest of this file's JS as visible text on the page. This is
                // exactly what was happening here before; do not put the literal closing tags back.
                const CLOSE_BODY = '</' + 'body>';
                const CLOSE_HTML = '</' + 'html>';

                const popupHtml = '<!DOCTYPE html>' +
                    '<html><head><title>' + esc(title) + '</title>' +
                    '<style>' +
                    'body{font-family:Arial;padding:20px;}' +
                    'table{width:100%;border-collapse:collapse;}' +
                    'th,td{border:1px solid #999;padding:6px;font-size:12px;}' +
                    'th{background:#f5f5f5;}' +
                    '</style>' +
                    '</head><body>' +
                    '<h3>' + esc(title) + '</h3>' +
                    clone.outerHTML +
                    CLOSE_BODY + CLOSE_HTML;

                win.document.open();
                win.document.write(popupHtml);
                win.document.close();

                setTimeout(function () {

                    win.print();

                }, 300);

            }

            function esc(v) {
                return (v ?? '').toString().replace(/[&<>"']/g, c => ({
                    '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
                }[c]));
            }

            function actionsCell(id) {
                return `<td>
                                                    <button class="btn btn-sm btn-outline-primary edit-btn" data-id="${id}">Edit</button>
                                                    <button class="btn btn-sm btn-outline-danger delete-btn" data-id="${id}">Delete</button>
                                                </td>`;
            }

            function yn(v) { return v === 'Y' ? 'Yes' : (v === 'N' ? 'No' : ''); }
            function dt(v) { return v ? new Date(v).toLocaleDateString() : ''; }

            function setStatus(message, isError) {
                status.textContent = message;
                status.className = 'rob-status ' + (isError ? 'text-danger' : 'text-success');
            }

            function collectFormData() {
                const data = {};
                new FormData(form).forEach((value, key) => { data[key] = value; });
                // normalize numeric-ish empty strings to null so the API doesn't choke on ""
                ['yearSanction', 'skewAngle', 'distanceLc', 'sanctionedCont', 'sanctionedDe', 'id'].forEach(k => {
                    if (data[k] === '') data[k] = null;
                });
                return data;
            }

            function populateForm(record) {
                document.getElementById('recordId').value = record.id || 0;
                const isUnSanction = (record.lcStatus || '').toString().trim().toLowerCase() === 'unsanction';
                document.getElementById('statusSanction').checked = !isUnSanction;
                document.getElementById('statusUnSanction').checked = isUnSanction;
                form.querySelector('#division').value = record.division || '';
                form.querySelector('#yearSanction').value = record.yearOfSanction || '';
                form.querySelector('#lcNo').value = record.lcNo || '';
                form.querySelector('#locationKm').value = record.locationKm || '';
                form.querySelector('#section').value = record.sectionName || '';
                form.querySelector('#spanArrangement').value = record.spanArrangement || '';
                form.querySelector('#skewAngle').value = record.skewAngle || '';
                form.querySelector('#distanceLc').value = record.distanceExistingLc || '';
                form.querySelector('#stateApproval').value = record.stateAuthorityApproval || '';
                form.querySelector('#dprConsultancy').value = record.dprConsultancy || '';
                form.querySelector('#executiveAgency').value = record.executiveAgency || '';
                form.querySelector('#gad').value = record.gad || '';
                form.querySelector('#checkedReceived').value = record.checkedReceived || '';
                form.querySelector('#sanctionedCont').value = record.sanctionedCont || '';
                form.querySelector('#sanctionedDe').value = record.sanctionedDe || '';
                form.querySelector('#tenderStatus').value = record.tenderStatus || '';
                form.querySelector('#sec7a').value = record.lc7a37a || '';
                form.querySelector('#sec20aGazette').value = record.gazette20A || '';
                form.querySelector('#sec20aPaper').value = record.paper20A || '';
                form.querySelector('#sec20b').value = record.form20B || '';
                form.querySelector('#sec20c').value = record.form20C || '';
                form.querySelector('#sec20d').value = record.form20D || '';
                form.querySelector('#sec20eGazette').value = record.gazette20E || '';
                form.querySelector('#sec20ePaper').value = record.paper20E || '';
                form.querySelector('#sec20f').value = record.form20F || '';
                form.querySelector('#landRemark').value = record.remark || '';
                form.querySelector('#utilSnt').value = record.stStatus || '';
                form.querySelector('#utilTrd').value = record.trdStatus || '';
                form.querySelector('#utilElectrical').value = record.electricalG || '';
                form.querySelector('#substructure').value = record.substructureStatus || '';
                form.querySelector('#superstructure').value = record.superStructureStatus || '';
                form.querySelector('#commissioning').value = record.commissioningStatus || '';
                form.querySelector('#exitsGad').value = record.gadExit || '';
                form.querySelector('#designField').value = record.design || '';
                form.querySelector('#exitNo').value = record.exitNo || '';
                form.querySelector('#noExit').value = record.noExit || '';
                form.querySelector('#nocClosingLc').value = record.nocClosingLc || '';
                form.querySelector('#soa').value = record.soa || '';

                // Yes/No remark textareas: fill them in from the record, then sync
                // each one's visibility (only shown when its select is "No").
                form.querySelector('#gadRemark').value = record.gadRemark || '';
                form.querySelector('#checkedReceivedRemark').value = record.checkedReceivedRemark || '';
                form.querySelector('#exitsGadRemark').value = record.exitsGadRemark || '';
                ['gad', 'checkedReceived', 'exitsGad'].forEach(syncYesNoRemark);

                window.scrollTo({ top: 0, behavior: 'smooth' });
            }

            // Column definitions per tab: key = field on the record, label = header text.
            // 'division' itself is left out of each table body since it's now the grouping/heading.
            const tabColumns = {
                basic: [
                    { key: 'id', label: 'ID' }, { key: 'yearOfSanction', label: 'Year' },
                    { key: 'lcNo', label: 'LC No.' }, { key: 'locationKm', label: 'Location Km' },
                    { key: 'sectionName', label: 'Section' }, { key: 'spanArrangement', label: 'Span Arrangement' },
                    { key: 'skewAngle', label: 'Skew Angle' }, { key: 'distanceExistingLc', label: 'Distance from Existing LC' },
                    { key: 'stateAuthorityApproval', label: 'State Authority Approval' },
                    { key: 'dprConsultancy', label: 'DPR Consultancy' }, { key: 'executiveAgency', label: 'Executive Agency' }
                ],
                tender: [
                    { key: 'id', label: 'ID' }, { key: 'lcNo', label: 'LC No.' },
                    { key: 'gad', label: 'GAD', fmt: yn }, { key: 'checkedReceived', label: 'Checked & Received', fmt: yn },
                    { key: 'sanctionedCont', label: 'Sanctioned Cont (Cr)' }, { key: 'sanctionedDe', label: 'Sanctioned DE (Cr)' },
                    { key: 'tenderStatus', label: 'Status of Tender' }
                ],
                land: [
                    { key: 'id', label: 'ID' }, { key: 'lcNo', label: 'LC No.' },
                    { key: 'lc7a37a', label: '7A/37A', fmt: dt }, { key: 'gazette20A', label: '20A Gazette', fmt: dt },
                    { key: 'paper20A', label: '20A Paper', fmt: dt }, { key: 'form20B', label: '20B', fmt: dt },
                    { key: 'form20C', label: '20C', fmt: dt }, { key: 'form20D', label: '20D', fmt: dt },
                    { key: 'gazette20E', label: '20E Gazette', fmt: dt }, { key: 'paper20E', label: '20E Paper', fmt: dt },
                    { key: 'form20F', label: '20F', fmt: dt }, { key: 'remark', label: 'Remark' }
                ],
                utility: [
                    { key: 'id', label: 'ID' }, { key: 'lcNo', label: 'LC No.' },
                    { key: 'stStatus', label: 'S & T' }, { key: 'trdStatus', label: 'TRD' }, { key: 'electricalG', label: 'Electrical (G)' }
                ],
                design: [
                    { key: 'id', label: 'ID' }, { key: 'lcNo', label: 'LC No.' },
                    { key: 'substructureStatus', label: 'Substructure' }, { key: 'superStructureStatus', label: 'Super Structure' },
                    { key: 'commissioningStatus', label: 'Commissioning' }, { key: 'gadExit', label: 'Exits/GAD', fmt: yn },
                    { key: 'design', label: 'Design' }, { key: 'exitNo', label: 'Exit No.' }, { key: 'noExit', label: 'No Exit' }
                ],
                noc: [
                    { key: 'id', label: 'ID' }, { key: 'lcNo', label: 'LC No.' },
                    { key: 'nocClosingLc', label: 'NOC of Closing LC' }, { key: 'soa', label: 'SOA' }
                ]
            };

            function groupByDivision(data) {
                const groups = {};
                data.forEach(r => {
                    const key = (r.division && r.division.trim()) ? r.division.trim() : 'Unspecified Division';
                    (groups[key] = groups[key] || []).push(r);
                });
                // Alphabetical by division name, case-insensitive
                return Object.keys(groups).sort((a, b) => a.localeCompare(b)).map(name => ({ name, rows: groups[name] }));
            }

            // A record counts as "UnSanction" only if lcStatus explicitly says so;
            // anything missing/blank/other is treated as "Sanction" (matches the form default).
            function isUnSanctionRow(r) {
                return (r.lcStatus || '').toString().trim().toLowerCase() === 'unsanction';
            }

            function buildRowsHtml(rows, columns) {
                if (!rows.length) {
                    return `<tr><td colspan="${columns.length + 1}" class="text-center text-muted">No records.</td></tr>`;
                }
                return rows.map(r => {
                    const cells = columns.map(c => `<td>${esc(c.fmt ? c.fmt(r[c.key]) : r[c.key])}</td>`).join('');
                    return `<tr>${cells}${actionsCell(r.id)}</tr>`;
                }).join('');
            }

            // uid must be unique per division+tab combination so nav/pane ids never collide
            // across the multiple division blocks and multiple category tabs rendered on the page.
            function buildDivisionTable(divisionName, rows, columns, uid, tabLabel) {
                const headerCells = columns.map(c => `<th>${esc(c.label)}</th>`).join('') + '<th style="width:130px;">Actions</th>';

                const sanctionRows = rows.filter(r => !isUnSanctionRow(r));
                const unsanctionRows = rows.filter(isUnSanctionRow);

                const sanctionTabId = `sanctionTab-${uid}`;
                const unsanctionTabId = `unsanctionTab-${uid}`;
                const navId = `statusTabs-${uid}`;
                const sanctionTableId = `tbl-${sanctionTabId}`;
                const unsanctionTableId = `tbl-${unsanctionTabId}`;

                const sanctionTitle = `${divisionName} - ${tabLabel} (Sanction)`;
                const unsanctionTitle = `${divisionName} - ${tabLabel} (UnSanction)`;
                const sanctionFile = sanitizeFilename(`${divisionName}_${tabLabel}_Sanction`);
                const unsanctionFile = sanitizeFilename(`${divisionName}_${tabLabel}_UnSanction`);

                const toolbar = (tableId, title, filename) => `
                                    <div class="d-flex justify-content-end gap-2 mb-2">
                                        <button type="button" class="btn btn-sm btn-outline-secondary export-print-btn"
                                                data-table-id="${tableId}" data-title="${esc(title)}">Print</button>
                                        <button type="button" class="btn btn-sm btn-outline-success export-excel-btn"
                                                data-table-id="${tableId}" data-filename="${esc(filename)}">Excel</button>
                                        <button type="button" class="btn btn-sm btn-outline-danger export-pdf-btn"
                                                data-table-id="${tableId}" data-title="${esc(title)}" data-filename="${esc(filename)}">PDF</button>
                                    </div>`;

                return `
                                            <div class="mb-4">
                                                <h6 class="fw-bold mb-2">${esc(divisionName)} <span class="text-muted fw-normal">(${rows.length} record${rows.length === 1 ? '' : 's'})</span></h6>
                                                <div class="table-responsive">

                        <ul class="nav nav-tabs mb-3" id="${navId}" role="tablist">
                        <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#${sanctionTabId}" type="button">Sanction (${sanctionRows.length})</button></li>
                        <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#${unsanctionTabId}" type="button">UnSanction (${unsanctionRows.length})</button></li>
                        </ul>
                        <div class="tab-content">
                        <div class="tab-pane fade show active" id="${sanctionTabId}">
                        ${toolbar(sanctionTableId, sanctionTitle, sanctionFile)}
                        <table id="${sanctionTableId}" class="table table-bordered table-hover align-middle table-sm">
                                                        <thead><tr>${headerCells}</tr></thead>
                                                        <tbody>${buildRowsHtml(sanctionRows, columns)}</tbody>
                                                    </table>
                        <div id="${sanctionTableId}-pagination" class="lc-pagination"></div>
                        </div>
                        <div class="tab-pane fade" id="${unsanctionTabId}">
                        ${toolbar(unsanctionTableId, unsanctionTitle, unsanctionFile)}
                        <table id="${unsanctionTableId}" class="table table-bordered table-hover align-middle table-sm">
                                                        <thead><tr>${headerCells}</tr></thead>
                                                        <tbody>${buildRowsHtml(unsanctionRows, columns)}</tbody>
                                                    </table>
                        <div id="${unsanctionTableId}-pagination" class="lc-pagination"></div>
                        </div>
                        </div>

                                                </div>
                                            </div>`;
            }

            function renderTabs(data) {
                if (!data || data.length === 0) {
                    Object.values(tabBodies).forEach(el => {
                        el.innerHTML = '<p class="text-center text-muted">No records found.</p>';
                    });
                    return;
                }

                const groups = groupByDivision(data);

                Object.keys(tabColumns).forEach(tabKey => {
                    const columns = tabColumns[tabKey];
                    tabBodies[tabKey].innerHTML = groups
                        .map((g, idx) => buildDivisionTable(g.name, g.rows, columns, `${tabKey}-${idx}`, tabTitles[tabKey] || tabKey))
                        .join('');

                    // Initialize independent 10-record pagination for every
                    // Sanction and UnSanction table in this category/division.
                    groups.forEach((g, idx) => {
                        const uid = `${tabKey}-${idx}`;
                        setupTablePagination(`tbl-sanctionTab-${uid}`);
                        setupTablePagination(`tbl-unsanctionTab-${uid}`);
                    });
                });
            }

            /*
             * Client-side pagination.
             * Every generated table has its own pagination state.
             * Exactly 10 data records are displayed on each page.
             */
            function setupTablePagination(tableId) {
                const rowsPerPage = 10;
                const table = document.getElementById(tableId);
                const pagination = document.getElementById(`${tableId}-pagination`);

                if (!table || !pagination) {
                    return;
                }

                const allRows = Array.from(table.querySelectorAll('tbody tr'));

                // Do not paginate the "No records." placeholder row.
                const dataRows = allRows.filter(row => row.querySelector('.edit-btn, .delete-btn'));

                pagination.innerHTML = '';

                if (dataRows.length <= rowsPerPage) {
                    dataRows.forEach(row => row.style.display = '');
                    if (dataRows.length > 0) {
                        pagination.innerHTML =
                            `<div class="lc-pagination-info">Showing 1 to ${dataRows.length} of ${dataRows.length} records</div>`;
                    }
                    return;
                }

                let currentPage = 1;
                const totalPages = Math.ceil(dataRows.length / rowsPerPage);

                function renderPage() {
                    const start = (currentPage - 1) * rowsPerPage;
                    const end = start + rowsPerPage;

                    dataRows.forEach((row, index) => {
                        row.style.display =
                            index >= start && index < end ? '' : 'none';
                    });

                    const startRecord = start + 1;
                    const endRecord = Math.min(end, dataRows.length);

                    pagination.innerHTML = `
                                <div class="lc-pagination-info">
                                    Showing ${startRecord} to ${endRecord} of ${dataRows.length} records
                                </div>
                                <div class="lc-pagination-controls">
                                    <button type="button"
                                            class="btn btn-sm btn-outline-primary lc-page-btn"
                                            data-page="prev"
                                            ${currentPage === 1 ? 'disabled' : ''}>
                                        &laquo; Previous
                                    </button>
                                    ${buildPageButtons(currentPage, totalPages)}
                                    <button type="button"
                                            class="btn btn-sm btn-outline-primary lc-page-btn"
                                            data-page="next"
                                            ${currentPage === totalPages ? 'disabled' : ''}>
                                        Next &raquo;
                                    </button>
                                </div>
                            `;

                    pagination.querySelectorAll('.lc-page-btn').forEach(button => {
                        button.addEventListener('click', function () {
                            const value = this.getAttribute('data-page');

                            if (value === 'prev' && currentPage > 1) {
                                currentPage--;
                            } else if (value === 'next' && currentPage < totalPages) {
                                currentPage++;
                            } else if (!isNaN(Number(value))) {
                                currentPage = Number(value);
                            }

                            renderPage();
                        });
                    });
                }

                function buildPageButtons(current, total) {
                    const maxVisible = 7;
                    let pages = [];

                    if (total <= maxVisible) {
                        for (let i = 1; i <= total; i++) {
                            pages.push(i);
                        }
                    } else {
                        pages.push(1);

                        let start = Math.max(2, current - 2);
                        let end = Math.min(total - 1, current + 2);

                        if (start > 2) {
                            pages.push('...');
                        }

                        for (let i = start; i <= end; i++) {
                            pages.push(i);
                        }

                        if (end < total - 1) {
                            pages.push('...');
                        }

                        pages.push(total);
                    }

                    return pages.map(page => {
                        if (page === '...') {
                            return `<span class="lc-page-ellipsis">...</span>`;
                        }

                        return `
                                    <button type="button"
                                            class="btn btn-sm ${page === current ? 'btn-primary' : 'btn-outline-primary'} lc-page-btn"
                                            data-page="${page}">
                                        ${page}
                                    </button>
                                `;
                    }).join('');
                }

                renderPage();
            }

            async function loadRecords() {
                Object.values(tabBodies).forEach(tb => {
                    tb.innerHTML = '<p class="text-center text-muted">Loading...</p>';
                });
                try {
                    const res = await fetch('?handler=List', { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                    const json = await res.json();
                    if (!json.success) {
                        setStatus(json.message || 'Failed to load records.', true);
                        return;
                    }
                    renderTabs(json.data);
                } catch (err) {
                    setStatus('Failed to load records: ' + err.message, true);
                }
            }

            // Single delegated listener on the shared tab-content wrapper covers all six grids.
            // Handle Export / Edit / Delete buttons
            const recordsTabs = document.getElementById("recordsTabsContent");

            if (recordsTabs) {

                recordsTabs.addEventListener("click", async function (e) {

                    // -------------------------
                    // Export Buttons
                    // -------------------------
                    const exportBtn = e.target.closest(
                        ".export-print-btn, .export-excel-btn, .export-pdf-btn"
                    );

                    if (exportBtn) {

                        const tableId = exportBtn.getAttribute("data-table-id");
                        const title = exportBtn.getAttribute("data-title") || "Records";
                        const filename = exportBtn.getAttribute("data-filename") || "records";

                        if (exportBtn.classList.contains("export-print-btn")) {

                            printTable(tableId, title);

                        }
                        else if (exportBtn.classList.contains("export-excel-btn")) {

                            exportTableToExcel(tableId, filename);

                        }
                        else if (exportBtn.classList.contains("export-pdf-btn")) {

                            exportTableToPdf(tableId, title, filename);

                        }

                        return;
                    }

                    // -------------------------
                    // Edit/Delete Buttons
                    // -------------------------
                    const btn = e.target.closest(".edit-btn, .delete-btn");

                    if (!btn)
                        return;

                    const id = btn.getAttribute("data-id");

                    if (!id)
                        return;

                    // -------------------------
                    // Edit
                    // -------------------------
                    if (btn.classList.contains("edit-btn")) {

                        try {

                            const response = await fetch(`?handler=Item&id=${id}`);

                            if (!response.ok)
                                throw new Error("Unable to load record.");

                            const json = await response.json();

                            if (json.success) {

                                populateForm(json.data);

                            }
                            else {

                                setStatus(json.message || "Record not found.", true);

                            }

                        }
                        catch (err) {

                            setStatus(err.message, true);

                        }

                        return;
                    }

                    // -------------------------
                    // Delete
                    // -------------------------
                    if (btn.classList.contains("delete-btn")) {

                        if (!confirm("Delete this record permanently?"))
                            return;

                        try {

                            const response = await fetch(`?handler=Delete&id=${id}`, {

                                method: "POST",

                                headers: {
                                    "RequestVerificationToken": antiForgeryToken
                                }

                            });

                            if (!response.ok)
                                throw new Error("Delete failed.");

                            const json = await response.json();

                            setStatus(json.message, !json.success);

                            if (json.success) {

                                await loadRecords();

                            }

                        }
                        catch (err) {

                            setStatus(err.message, true);

                        }
                    }

                });

            }

            form.addEventListener('submit', async (e) => {
                e.preventDefault();
                if (!form.checkValidity()) {
                    form.classList.add('was-validated');
                    return;
                }

                const payload = collectFormData();
                try {
                    const res = await fetch('?handler=Save', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': antiForgeryToken
                        },
                        body: JSON.stringify(payload)
                    });
                    const json = await res.json();
                    setStatus(json.message, !json.success);
                    if (json.success) {
                        form.reset();
                        form.classList.remove('was-validated');
                        document.getElementById('recordId').value = 0;
                        ['gad', 'checkedReceived', 'exitsGad'].forEach(syncYesNoRemark);
                        loadRecords();
                    }
                } catch (err) {
                    setStatus('Save failed: ' + err.message, true);
                }
            });

            resetBtn.addEventListener('click', () => {
                form.reset();
                form.classList.remove('was-validated');
                document.getElementById('recordId').value = 0;
                ['gad', 'checkedReceived', 'exitsGad'].forEach(syncYesNoRemark);
                setStatus('', false);
            });

            loadRecords();
        })();
    </script>
}