<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" sizes="32x32" href="img/favicon.ico">
    <title>@ViewData["Title"] - RoadSafetyProject</title>
    <script type="importmap"></script>
    <!-- Bootstrap 5 -->
    <link href="~/css/bootstrap.min.css" rel="stylesheet" />
    <!-- jsPDF -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>

    <!-- jsPDF AutoTable -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js"></script>

    <!-- Excel -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" type="text/css" href="~/css/main.css" />
    <!--edit table-->
    <link rel="stylesheet" type="text/css" href="~/css/editable-table.css" />
    
</head>
<body>
    <header>
        <!-- Top Navigation -->
        <nav class="navbar navbar-expand-lg navbar-light shadow-sm sticky-top">
            <div class="container-fluid">
                <!-- Mobile Menu Button -->
                <button class="btn d-lg-none me-2"
                        type="button"
                        data-bs-toggle="offcanvas"
                        data-bs-target="#mobileMenu">
                    <i class="bi bi-list fs-3"></i>
                </button>
                <!-- Logo -->
                <a class="navbar-brand d-flex align-items-center" asp-area="" asp-page="/Index">
                    <span class="ms-2 fw-bold">Road Safety Project</span>
                </a>
                <!-- Desktop Menu -->
                <div class="collapse navbar-collapse">
                    <ul class="navbar-nav ms-4">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/organization">
                                <i class="bi bi-people me-1"></i> Organization
                            </a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown"><i class="bi bi-clipboard2-data me-1"></i>Projects</a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-area="" asp-page="/drawing">Drawing</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-page="/division">Division</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-page="/pssa-engage">PSSA Engage</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-page="/addnewlc">Add New LC</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-page="/viewalllc">View All LC</a></li>
                            </ul>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/about">
                                <i class="bi bi-people me-1"></i> About Us
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/policy">
                                <i class="bi bi-sticky-fill me-1"></i> Policy
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/contact">
                                <i class="bi bi-person-fill me-1"></i> Contact
                            </a>
                        </li>
                    </ul>
                </div>
                <!-- Right User Info -->
                <!--<div class="d-none d-lg-flex align-items-center">
               <span class="me-3">Welcome Admin</span>
               <button class="btn btn-outline-danger btn-sm">
               Logout
               </button>
            </div>-->
            </div>
        </nav>
        <!-- Mobile Sidebar -->
        <div class="offcanvas offcanvas-start"
             tabindex="-1"
             id="mobileMenu">
            <div class="offcanvas-header border-bottom">
                <h5 class="offcanvas-title">
                    RSP
                </h5>
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="offcanvas">
                </button>
            </div>
            <div class="offcanvas-body p-0">
                <ul class="list-group list-group-flush">
                    <li class="list-group-item">
                        <a href="organization.html" class="text-decoration-none text-dark">
                            <i class="bi bi-house-door me-2"></i>
                            Organization
                        </a>
                    </li>
                    <li class="list-group-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown"><i class="bi bi-clipboard2-data me-1"></i>Projects</a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" asp-area="" asp-page="/drawing">Drawing</a></li>
                            <li><a class="dropdown-item" asp-area="" asp-page="/division">Division</a></li>
                            <li><a class="dropdown-item" asp-area="" asp-page="/pssa-engage">PSSA Engage</a></li>
                            <li><a class="dropdown-item" asp-area="" asp-page="/addnewlc">Add New LC</a></li>
                            <li><a class="dropdown-item" asp-area="" asp-page="/viewalllc">View All LC</a></li>
                        </ul>
                    </li>
                    <li class="list-group-item">
                        <a href="about.html" class="text-decoration-none text-dark">
                            <i class="bi bi-people me-2"></i>
                            About Us
                        </a>
                    </li>
                    <li class="list-group-item">
                        <a href="#" class="text-decoration-none text-dark">
                            <i class="bi bi-sticky-fill me-2"></i>
                            Policy
                        </a>
                    </li>
                    <li class="list-group-item">
                        <a href="contact.html" class="text-decoration-none text-dark">
                            <i class="bi bi-person-fill me-2"></i>
                            Contact
                        </a>
                    </li>
                    <!--<li class="list-group-item">
                  <a href="#" class="text-decoration-none text-danger">
                  <i class="bi bi-box-arrow-right me-2"></i>
                  Logout
                  </a>
               </li>-->
                </ul>
            </div>
        </div>
        <!-- Mobile Sidebar -->
    </header>
    <div class="container-fluid" id="contain-main">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer">
        <div class="container">
            &copy; 2026 C/RSP | All Rights Reserved
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://code.jquery.com/jquery-1.12.4.min.js"></script>
    <script src="~/js/main.js"></script>
    <script src="js/rob-form.js"></script>
    <script src="~/js/editable-table.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
