@page
@model RoadSafetyProject.Pages.contactModel
@{
    ViewData["Title"] = "Road Safety Project";
}

<!-- Contact -->
<div class="container-fluid py-5">
    <div class="text-center mb-5">
        <h2 class="fw-bold text-primary">
            Contact Us
        </h2>
        <h3 class="text-muted  pt-3">
            Central Railway Construction Department
        </h3>
    </div>
    <div class="row g-4">
        <!-- Google Map -->
        <div class="col-lg-8">
            <div class="contact-card">
                <iframe src="https://maps.google.com/maps?q=Chhatrapati%20Shivaji%20Maharaj%20Terminus&t=&z=15&ie=UTF8&iwloc=&output=embed"
                        allowfullscreen=""
                        loading="lazy">
                </iframe>
            </div>
        </div>
        <!-- Contact Details -->
        <div class="col-lg-4">
            <div class="contact-card p-4">
                <h3 class="mb-4 text-primary">
                    <i class="bi bi-building"></i>
                    Office Information
                </h3>
                <div class="contact-item">
                    <i class="bi bi-geo-alt-fill text-danger"></i>
                    <div>
                        <strong>Address</strong>
                        <p>
                            GM Building , 2<sup>nd</sup> Floor , Office of CAO/C/RSP
                        </p>
                    </div>
                </div>
                <div class="contact-item">
                    <i class="bi bi-telephone-fill text-success"></i>
                    <div>
                        <strong>Office</strong>
                        <p>
                            +91 (22) 2261 2857
                        </p>
                    </div>
                </div>
                <div class="contact-item">
                    <i class="bi bi-phone-fill text-primary"></i>
                    <div>
                        <strong>Fixed Line</strong>
                        <p>
                            +91 (22) 628 54761
                        </p>
                    </div>
                </div>
                <div class="contact-item">
                    <i class="bi bi-envelope-fill text-warning"></i>
                    <div>
                        <strong>Email</strong>
                        <p>
                            <a href="mailto:constrsphqcr@gmail.com">
                                constrsphqcr@gmail.com
                            </a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
